{
  "name": "Lean 4 + Mathlib (DGBOZK)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.elan/bin:${containerEnv:PATH}"
  }
}
